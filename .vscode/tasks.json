{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-fcn",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BlazorDise.Fcn/BlazorDise.Fcn.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BlazorDise.Ui.Server/BlazorDise.Ui.Server.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--non-interactive",
        "--project",
        "${workspaceFolder}/BlazorDise.Ui.Server/BlazorDise.Ui.Server.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-client",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BlazorDise.Client.Ui/BlazorDise.Client.Ui.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-client",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--non-interactive",
        "--project",
        "${workspaceFolder}/BlazorDise.Client.Ui/BlazorDise.Client.Ui.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-fcn",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/BlazorDise.Fcn/BlazorDise.Fcn.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/BlazorDise.Ui.Server/BlazorDise.Ui.Server.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "func-start",
      "type": "shell",
      "command": "func host start",
      "options": {
        "cwd": "${workspaceFolder}/BlazorDise.Fcn",
        "env": {
          "DOTNET_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "dependsOn": "build-fcn",
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Host lock lease acquired by instance ID.*$|^.*Starting Azure Functions.*$|^.*Worker process started.*$",
          "endsPattern": "^.*Worker process started and initialized.*$|^.*Host started.*$"
        }
      }
    }
  ]
}
